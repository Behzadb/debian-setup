# betterlockscreen configuration — Catppuccin Mocha
# Docs: https://github.com/betterlockscreen/betterlockscreen#configuration
#
# IMPORTANT: betterlockscreen passes these to i3lock-color, so colors are
# 8-digit RRGGBBAA with NO leading '#', and the variable names are NOT
# underscored (e.g. `ringcolor`, not `ring_color`). Getting either wrong makes
# the value silently ignored (lock still works, but with default colors).
# Verify the names your version reads with:
#   grep -oE '\b[a-z]*color[a-z]*\b' "$(command -v betterlockscreen)" | sort -u

# ─── Wallpaper & blur ────────────────────────────────────────────────────────
# Pre-cache with: betterlockscreen -u /path/to/wallpaper   (the setup generates a
# Catppuccin solid one at ~/.config/i3/wallpaper.png if you have none).
blur_strength="0x8"

# ─── Ring (the password indicator circle) ───────────────────────────────────
ringcolor=89b4faff          # Catppuccin Blue
ringvercolor=a6e3a1ff       # Green   — verifying
ringwrongcolor=f38ba8ff     # Red     — wrong password
ringclearcolor=fab387ff     # Peach   — cleared

# ─── Inside of the ring ──────────────────────────────────────────────────────
insidecolor=1e1e2e66        # Base, transparent
insidevercolor=1e1e2e66
insidewrongcolor=f38ba866
insideclearcolor=1e1e2e66

# ─── Key press / backspace highlight ─────────────────────────────────────────
keyhlcolor=cba6f7ff         # Mauve
bshlcolor=f38ba8ff          # Red
separatorcolor=00000000     # Transparent

# ─── Text ────────────────────────────────────────────────────────────────────
timecolor=cdd6f4ff          # Text
datecolor=bac2deff          # Subtext1
layoutcolor=cdd6f4ff
verifcolor=a6e3a1ff         # Green while verifying
wrongcolor=f38ba8ff         # Red on wrong password
greetercolor=89b4faff       # Blue
loginbox=1e1e2e88           # Box behind the indicator (Base, semi-transparent)

# ─── Typography ──────────────────────────────────────────────────────────────
font="FiraCode Nerd Font"

# ─── Clock / date format (strftime) ──────────────────────────────────────────
time_format="%H:%M"
date_format="%A, %d %B"

# ─── Effects ─────────────────────────────────────────────────────────────────
fx_list=(blur)
