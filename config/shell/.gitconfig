# Git global configuration template
# Copy to ~/.gitconfig and customize with your details

[user]
    name = Your Name
    email = your.email@example.com

[core]
    editor = nvim
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    autocrlf = false
    pager = less -FRSX

[init]
    defaultBranch = main

[pull]
    rebase = true

[fetch]
    prune = true

[push]
    default = current
    followTags = true

[merge]
    conflictstyle = diff3
    tool = nvim

[mergetool]
    keepBackup = false

[diff]
    tool = nvim
    algorithm = histogram

[difftool]
    prompt = false

[rebase]
    autoStash = true
    abbreviateCommands = true

[log]
    date = short

[alias]
    # Status and info
    st = status
    co = checkout
    br = branch
    bra = branch -a
    rb = rebase
    
    # Commit commands
    ci = commit
    ca = commit --amend
    can = commit --amend --no-edit
    
    # Log and history
    lg = log --oneline --graph --all
    lgs = log --oneline --graph --all --simplify-by-decoration
    last = log -1 HEAD
    
    # Diff
    d = diff
    ds = diff --staged
    
    # Staging
    aa = add --all
    ap = add --patch
    
    # Cleanup
    clean-branches = branch -vv | grep 'gone]' | awk '{print $1}' | xargs -r git branch -d
    
    # Tag management
    tag-list = tag -l --format='%(refname:short): %(creatordate:short) - %(subject)'

[color]
    ui = true
    branch = true
    diff = true
    status = true

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red
    new = green

[color "status"]
    added = green
    changed = yellow
    untracked = red

[commit]
    gpgsign = false

[tag]
    gpgsign = false

# Security settings
[url "ssh://git@github.com/"]
    insteadOf = https://github.com/

# Large file support (install git-lfs first)
