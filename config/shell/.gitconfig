# Git global configuration (symlinked to ~/.gitconfig by dotbot).
# Personal identity is NOT stored here — it lives in ~/.gitconfig.local (which
# is git-ignored) and is filled in by scripts/07-post-installation.sh. This
# keeps your name/email out of the tracked repo and avoids writing through the
# symlink. Anything in ~/.gitconfig.local overrides the values below.
[include]
    path = ~/.gitconfig.local

[core]
    editor = nvim
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    autocrlf = false
    pager = delta

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Catppuccin Mocha
    hyperlinks = true

[interactive]
    diffFilter = delta --color-only

[init]
    defaultBranch = main

[pull]
    rebase = true

[fetch]
    prune = true

[push]
    default = current
    followTags = true

[merge]
    conflictstyle = diff3
    # 'nvimdiff' is the valid built-in tool name (plain 'nvim' is not recognised)
    tool = nvimdiff

[mergetool]
    keepBackup = false

[diff]
    tool = nvimdiff
    algorithm = histogram

[difftool]
    prompt = false

[rebase]
    autoStash = true
    abbreviateCommands = true

[log]
    date = short

[alias]
    # Status and info
    st = status
    co = checkout
    br = branch
    bra = branch -a
    rb = rebase
    
    # Commit commands
    ci = commit
    ca = commit --amend
    can = commit --amend --no-edit
    
    # Log and history
    lg = log --oneline --graph --all
    lgs = log --oneline --graph --all --simplify-by-decoration
    last = log -1 HEAD
    
    # Diff
    d = diff
    ds = diff --staged
    
    # Staging
    aa = add --all
    ap = add --patch
    
    # Cleanup
    clean-branches = branch -vv | grep 'gone]' | awk '{print $1}' | xargs -r git branch -d
    
    # Tag management
    tag-list = tag -l --format='%(refname:short): %(creatordate:short) - %(subject)'

[color]
    ui = true
    branch = true
    diff = true
    status = true

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red
    new = green

[color "status"]
    added = green
    changed = yellow
    untracked = red

[commit]
    gpgsign = false

[tag]
    gpgsign = false

# Optional: rewrite GitHub HTTPS remotes to SSH. Left DISABLED by default because
# it breaks anonymous HTTPS clones and tools that fetch over HTTPS (e.g. `go get`,
# package managers) until your SSH key is added to GitHub. Uncomment to enable.
# [url "ssh://git@github.com/"]
#     insteadOf = https://github.com/

# Large file support (install git-lfs first)
# [filter "lfs"]
#     clean = git-lfs clean -- %f
#     smudge = git-lfs smudge -- %f
#     process = git-lfs process
#     required = true
