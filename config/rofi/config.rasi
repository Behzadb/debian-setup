/* Rofi main configuration */
/* Enables drun mode and sets Catppuccin theme — avoids system defaults (Arc-Dark etc.) */

configuration {
    /* drun = .desktop app launcher, run = command, window = open windows */
    modi: "drun,run,window";

    /* Nerd Font so the mode glyphs ( Apps /  Run /  Windows) render — */
    /* matches kitty/polybar/i3. Without this rofi uses a default font and the */
    /* glyphs show as boxes. */
    font:                 "FiraCode Nerd Font 12";

    show-icons:           true;
    icon-theme:           "Papirus-Dark";

    /* drun: application launcher */
    drun-display-format:  "{name}";
    display-drun:         " Apps";
    display-run:          " Run";
    display-window:       " Windows";

    /* Fuzzy matching for fast search */
    matching:             "fuzzy";
    sort:                 true;
    sorting-method:       "fzf";

    /* Terminal used when launching terminal apps from drun */
    terminal:             "kitty";

}
/* Load the Catppuccin Mocha theme. Use a relative @import (resolved against
   this file's directory) — rofi does NOT expand "~", so an absolute "~/..."
   path silently fails and falls back to the system theme (Arc-Dark, etc.). */
@import          "catppuccin-mocha.rasi"