# i3 config file (v4)
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

# Font for window titles and bar
font pango:FiraCode Nerd Font 11

# $mod = Mod1 (Alt) or Mod4 (Super/Windows key)
set $mod Mod4

# Direction keys (vim-style)
set $left h
set $down j
set $up k
set $right l

# Workspaces
set $ws1 "1:code"
set $ws2 "2:browser"
set $ws3 "3:term"
set $ws4 "4:chat"
set $ws5 "5:media"
set $ws6 "6:vm"
set $ws7 "7:k8s"
set $ws8 "8:work"
set $ws9 "9:dev"
set $ws10 "10:system"

# Default terminal (Kitty: GPU-accelerated, ligature support, image protocol)
set $term kitty
# Application launcher: rofi (installed by the window-manager module), with dmenu as a fallback
set $menu sh -c 'command -v rofi >/dev/null && rofi -show drun || dmenu_run'

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Start a terminal (fall back to x-terminal-emulator, then xterm, if kitty is missing)
bindsym $mod+Return exec --no-startup-id sh -c 'kitty || x-terminal-emulator || xterm'

# Kill focused window
bindsym $mod+Shift+q kill

# Start application launcher
bindsym $mod+d exec --no-startup-id $menu

# Change focus (vim-style)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move focused window (vim-style)
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Split orientation
bindsym $mod+b split h
bindsym $mod+v split v

# Enter fullscreen mode
bindsym $mod+f fullscreen toggle

# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Focus parent container
bindsym $mod+a focus parent

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload the configuration file
bindsym $mod+Shift+c reload

# Restart i3 inplace
bindsym $mod+Shift+r restart

# Exit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# Resize mode
mode "resize" {
    bindsym $left resize shrink width 10 px or 10 ppt
    bindsym $down resize grow height 10 px or 10 ppt
    bindsym $up resize shrink height 10 px or 10 ppt
    bindsym $right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Brightness control (brightnessctl: works with DRM/sysfs backlight on modern kernels)
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Volume control
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Status bar - handled by Polybar (replaces i3status)
# Polybar starts via exec_always below - see config/polybar/config.ini
# To configure: edit ~/.config/polybar/config.ini

# Window colors - Catppuccin Mocha palette
# class                 border    bg        text      indicator child_border
client.focused          #89b4fa   #1e1e2e   #cdd6f4   #89b4fa   #89b4fa
client.focused_inactive #313244   #1e1e2e   #6c7086   #313244   #313244
client.unfocused        #181825   #1e1e2e   #585b70   #181825   #181825
client.urgent           #f38ba8   #1e1e2e   #f38ba8   #f38ba8   #f38ba8
client.placeholder      #11111b   #1e1e2e   #cdd6f4   #11111b   #11111b

# Startup applications
exec --no-startup-id picom
exec --no-startup-id dunst
exec --no-startup-id copyq
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id sh -c 'feh --bg-scale ~/.config/i3/wallpaper.png 2>/dev/null || feh --bg-fill ~/.config/i3/wallpaper.jpg 2>/dev/null || true'

# Auto-lock: lock before the system suspends (lid close / systemctl suspend) and
# after 10 min idle. xss-lock takes logind's sleep inhibitor so the lock screen
# is up before the machine sleeps; resume shows the lock screen.
exec --no-startup-id xset s 600 600
# Locker = plain i3lock (solid Catppuccin base). betterlockscreen needs
# i3lock-color (not installed here — see TODO.md); using plain i3lock directly
# avoids its "color not defined"/"3-byte" errors and locks reliably. `-n` keeps
# i3lock in the foreground so xss-lock can track it for the sleep inhibitor.
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -n -c 1e1e2e

# Multi-monitor setup - auto-configure on startup
exec --no-startup-id sh -c 'bash ~/.config/i3/setup-monitors.sh auto 2>/dev/null || true'

# Workspace assignments - explicit monitor binding
# Home/Office: Workspaces 1-5 on primary (code, browser, term, chat, media)
# Development: Workspaces 6-10 on secondary (vm, k8s, work, dev, system)
# Uncomment to bind workspaces to specific monitors:
# workspace $ws1 output eDP-1          # Primary laptop screen
# workspace $ws2 output eDP-1
# workspace $ws3 output eDP-1
# workspace $ws4 output eDP-1
# workspace $ws5 output eDP-1
# workspace $ws6 output HDMI-1         # Secondary external monitor
# workspace $ws7 output HDMI-1
# workspace $ws8 output HDMI-1
# workspace $ws9 output HDMI-1
# workspace $ws10 output HDMI-1

# Application assignments
assign [class="Firefox"] $ws2
assign [class="Chromium"] $ws2
assign [class="Code"] $ws1
assign [class="Slack"] $ws4
assign [class="Discord"] $ws4
assign [class="VirtualBox Manager"] $ws6

# Floating windows
for_window [class="Pavucontrol"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="Thunar"] floating enable
for_window [class="copyq"] floating enable
for_window [class="flameshot"] floating enable
for_window [window_role="pop-up"] floating enable

# Lock screen — plain i3lock (solid Catppuccin base), reliable on plain i3lock.
# For the blurred Catppuccin ring, install i3lock-color (see TODO.md) and switch
# this back to `betterlockscreen -l blur`.
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 1e1e2e

# Screenshot (flameshot: GUI region select with annotation)
bindsym Print exec flameshot gui
bindsym $mod+Print exec flameshot screen -c
bindsym $mod+Shift+Print exec flameshot full -p ~/Pictures/screenshots

# Clipboard history (copyq)
bindsym $mod+Shift+v exec copyq toggle

# Git TUI (lazygit in Kitty)
bindsym $mod+g exec --no-startup-id kitty --class lazygit -e lazygit

# Monitor management keybindings
# Interactive mode prompts for input, so it must run inside a terminal.
bindsym $mod+Shift+m exec --no-startup-id kitty -e bash ~/.config/i3/setup-monitors.sh interactive
bindsym $mod+Shift+n exec --no-startup-id bash ~/.config/i3/setup-monitors.sh auto

# Power profile switching (ThinkPad T14) — runs /usr/local/bin/power-profile via
# passwordless sudo (configured by scripts/04-power-management.sh).
set $powermode "power  (p) performance   (b) balanced   (s) powersave   (a) auto"
mode $powermode {
    bindsym p exec --no-startup-id sh -c 'sudo power-profile performance && notify-send -t 2000 "Power profile" "Performance"'; mode "default"
    bindsym b exec --no-startup-id sh -c 'sudo power-profile balanced && notify-send -t 2000 "Power profile" "Balanced"'; mode "default"
    bindsym s exec --no-startup-id sh -c 'sudo power-profile powersave && notify-send -t 2000 "Power profile" "Power save"'; mode "default"
    bindsym a exec --no-startup-id sh -c 'sudo power-profile auto && notify-send -t 2000 "Power profile" "Auto (TLP AC/BAT)"'; mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+p mode $powermode

# Network / cellular (WWAN) management
# Super+Shift+w → NetworkManager TUI (add/connect WiFi or "Mobile broadband")
bindsym $mod+Shift+w exec --no-startup-id kitty -e nmtui
# Super+Control+w → ModemManager GUI (signal / SMS / USSD); no-op if not installed
bindsym $mod+Control+w exec --no-startup-id sh -c 'command -v modem-manager-gui >/dev/null && modem-manager-gui'

# Focus specific monitor
bindsym $mod+Control+Left focus output left
bindsym $mod+Control+Right focus output right

# Move workspace to monitor
bindsym $mod+Control+Shift+Left move workspace to output left
bindsym $mod+Control+Shift+Right move workspace to output right

# Notes and tips:
# - Use 'xdotool search --name' to find window properties
# - Use 'xprop' to inspect window properties
# - Multi-monitor: Press Super+Shift+M for interactive setup
# - Multi-monitor: Press Super+Shift+N for auto-detection
# - Monitor profiles: ~/.config/i3/monitor-profiles/
# - See ~/.config/i3/config.d/ for additional modular configs
