# Dunst Notification Daemon Configuration - Catppuccin Mocha Theme
# Docs: https://dunst-project.org/documentation/

[global]
    # Display
    monitor = 0
    follow = mouse

    # Geometry
    width = (200, 400)
    height = (0, 300)
    origin = top-right
    offset = 12x48
    scale = 0
    gap_size = 6

    # Appearance
    corner_radius = 8
    frame_width = 2
    frame_color = "#89b4fa"
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    separator_color = frame
    separator_height = 2

    # Text
    font = FiraCode Nerd Font 11
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    # Icons — Papirus-Dark is installed by the window-manager module; hicolor is the fallback
    icon_theme = "Papirus-Dark, hicolor"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    # Behavior
    sort = yes
    indicate_hidden = yes
    show_age_threshold = 60s
    hide_duplicate_count = false
    show_indicators = yes

    # Timeouts
    sticky_history = yes
    history_length = 20

    # Click actions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    # Progress bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    timeout = 5
    icon = dialog-information

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 8
    icon = dialog-information

[urgency_critical]
    background = "#f38ba8"
    foreground = "#1e1e2e"
    frame_color = "#f38ba8"
    timeout = 0
    icon = dialog-error

# Battery warning notifications
[battery_low]
    appname = "Battery Warning"
    background = "#f9e2af"
    foreground = "#1e1e2e"
    frame_color = "#f9e2af"
    timeout = 0
