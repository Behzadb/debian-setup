# versions.env — Pinned binary versions for reproducible installs
#
# Usage:
#   Edit this file to pin specific versions, OR set environment variables
#   before running setup.sh (env vars take precedence).
#
#   Use "latest" to always fetch the newest release from GitHub.
#   Use a tag like "v1.30.3" to pin a specific version.
#
# Example override before running setup:
#   export KUBECTL_VERSION=v1.30.3
#   sudo -E ./setup.sh

# ── Kubernetes ecosystem ────────────────────────────────────────────────────
KUBECTL_VERSION="${KUBECTL_VERSION:-latest}"
HELM_VERSION="${HELM_VERSION:-latest}"
KIND_VERSION="${KIND_VERSION:-latest}"
K9S_VERSION="${K9S_VERSION:-latest}"
STERN_VERSION="${STERN_VERSION:-latest}"
KUBECTX_VERSION="${KUBECTX_VERSION:-latest}"
KUBESTR_VERSION="${KUBESTR_VERSION:-v0.4.48}"       # pinned — slow release cadence

# ── Development tools ───────────────────────────────────────────────────────
LAZYGIT_VERSION="${LAZYGIT_VERSION:-latest}"
ATUIN_VERSION="${ATUIN_VERSION:-latest}"

# ── DevSecOps ───────────────────────────────────────────────────────────────
SOPS_VERSION="${SOPS_VERSION:-latest}"
DIVE_VERSION="${DIVE_VERSION:-latest}"

# ── Networking ──────────────────────────────────────────────────────────────
TRIPPY_VERSION="${TRIPPY_VERSION:-latest}"
DOGGO_VERSION="${DOGGO_VERSION:-latest}"

# ── Productivity ────────────────────────────────────────────────────────────
ACTIVITYWATCH_VERSION="${ACTIVITYWATCH_VERSION:-v0.13.2}"
