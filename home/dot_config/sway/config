# Sway config — Catppuccin Mocha
# Full parity with i3 config. Wayland-native tools replace X11 equivalents:
#   flameshot → grim + slurp     copyq → cliphist + wofi
#   betterlockscreen → swaylock  picom → none (Sway composites natively)
#   pactl → wpctl                arandr → kanshi / swaymsg output

font pango:FiraCode Nerd Font 11
set $mod Mod4

# ── Direction keys (vim-style — identical to i3) ──────────────────────────
set $left  h
set $down  j
set $up    k
set $right l

# ── Applications ─────────────────────────────────────────────────────────
set $term  kitty
set $menu  wofi --show drun --allow-images

# ── Core bindings ─────────────────────────────────────────────────────────
floating_modifier $mod normal
bindsym $mod+Return       exec $term
bindsym $mod+Shift+q      kill
bindsym $mod+d            exec $menu
bindsym $mod+Shift+c      reload
bindsym $mod+Shift+r      reload
bindsym $mod+Shift+e      exec swaynag -t warning -m 'Exit Sway?' -B 'Yes, exit' 'swaymsg exit'

# ── Focus ─────────────────────────────────────────────────────────────────
bindsym $mod+$left   focus left
bindsym $mod+$down   focus down
bindsym $mod+$up     focus up
bindsym $mod+$right  focus right

# ── Move ──────────────────────────────────────────────────────────────────
bindsym $mod+Shift+$left   move left
bindsym $mod+Shift+$down   move down
bindsym $mod+Shift+$up     move up
bindsym $mod+Shift+$right  move right

# ── Splits & layout ──────────────────────────────────────────────────────
bindsym $mod+b  splith
bindsym $mod+v  splitv
bindsym $mod+f  fullscreen toggle
bindsym $mod+s  layout stacking
bindsym $mod+w  layout tabbed
bindsym $mod+e  layout toggle split
bindsym $mod+Shift+space  floating toggle
bindsym $mod+space        focus mode_toggle
bindsym $mod+a            focus parent

# ── Workspaces (matches i3: 10 named) ────────────────────────────────────
set $ws1  "1:code"
set $ws2  "2:browser"
set $ws3  "3:term"
set $ws4  "4:chat"
set $ws5  "5:media"
set $ws6  "6:vm"
set $ws7  "7:k8s"
set $ws8  "8:work"
set $ws9  "9:dev"
set $ws10 "10:system"

bindsym $mod+1  workspace number $ws1
bindsym $mod+2  workspace number $ws2
bindsym $mod+3  workspace number $ws3
bindsym $mod+4  workspace number $ws4
bindsym $mod+5  workspace number $ws5
bindsym $mod+6  workspace number $ws6
bindsym $mod+7  workspace number $ws7
bindsym $mod+8  workspace number $ws8
bindsym $mod+9  workspace number $ws9
bindsym $mod+0  workspace number $ws10

bindsym $mod+Shift+1  move container to workspace number $ws1
bindsym $mod+Shift+2  move container to workspace number $ws2
bindsym $mod+Shift+3  move container to workspace number $ws3
bindsym $mod+Shift+4  move container to workspace number $ws4
bindsym $mod+Shift+5  move container to workspace number $ws5
bindsym $mod+Shift+6  move container to workspace number $ws6
bindsym $mod+Shift+7  move container to workspace number $ws7
bindsym $mod+Shift+8  move container to workspace number $ws8
bindsym $mod+Shift+9  move container to workspace number $ws9
bindsym $mod+Shift+0  move container to workspace number $ws10

# ── Multi-monitor ─────────────────────────────────────────────────────────
bindsym $mod+Control+Left          focus output left
bindsym $mod+Control+Right         focus output right
bindsym $mod+Control+Shift+Left    move workspace to output left
bindsym $mod+Control+Shift+Right   move workspace to output right

# ── Resize mode ───────────────────────────────────────────────────────────
mode "resize" {
    bindsym $left   resize shrink width  10px
    bindsym $down   resize grow   height 10px
    bindsym $up     resize shrink height 10px
    bindsym $right  resize grow   width  10px
    bindsym Return  mode "default"
    bindsym Escape  mode "default"
}
bindsym $mod+r mode "resize"

# ── Hardware keys ─────────────────────────────────────────────────────────
bindsym XF86MonBrightnessUp    exec brightnessctl set +5%
bindsym XF86MonBrightnessDown  exec brightnessctl set 5%-
bindsym XF86AudioRaiseVolume   exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume   exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute          exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioPlay          exec playerctl play-pause
bindsym XF86AudioNext          exec playerctl next
bindsym XF86AudioPrev          exec playerctl previous

# ── Screenshots (grim + slurp — Wayland native) ───────────────────────────
# Region select → clipboard
bindsym Print              exec grim -g "$(slurp)" - | wl-copy
# Full screen → file
bindsym $mod+Print         exec grim ~/Pictures/screenshots/$(date '+%Y%m%d_%H%M%S').png
# Region select → file + clipboard
bindsym $mod+Shift+Print   exec grim -g "$(slurp)" ~/Pictures/screenshots/$(date '+%Y%m%d_%H%M%S').png

# ── Clipboard history (cliphist + wofi) ──────────────────────────────────
bindsym $mod+Shift+v  exec cliphist list | wofi --dmenu -p "Clipboard" | cliphist decode | wl-copy

# ── Productivity ──────────────────────────────────────────────────────────
# lazygit in Kitty floating window (matches i3: Super+g)
bindsym $mod+g  exec $term --class lazygit -e lazygit

# ── Lock screen (swaylock — Catppuccin Mocha ring) ────────────────────────
set $lock swaylock \
    --color 1e1e2e \
    --inside-color 1e1e2e \
    --ring-color 89b4fa \
    --ring-ver-color cba6f7 \
    --ring-wrong-color f38ba8 \
    --key-hl-color a6e3a1 \
    --line-color 00000000 \
    --separator-color 00000000 \
    --text-color cdd6f4 \
    --caps-lock-key-hl-color f9e2af \
    --indicator-radius 80 \
    --indicator-thickness 6 \
    --clock \
    --timestr "%H:%M" \
    --datestr "%a %Y-%m-%d"

bindsym $mod+Shift+x exec $lock

# ── Catppuccin Mocha window borders (identical to i3) ─────────────────────
# class                  border    bg        text      indicator  child_border
client.focused           #89b4fa   #1e1e2e   #cdd6f4   #89b4fa    #89b4fa
client.focused_inactive  #313244   #1e1e2e   #6c7086   #313244    #313244
client.unfocused         #181825   #1e1e2e   #585b70   #181825    #181825
client.urgent            #f38ba8   #1e1e2e   #f38ba8   #f38ba8    #f38ba8
client.placeholder       #11111b   #1e1e2e   #cdd6f4   #11111b    #11111b

# ── Gaps (Sway-native — no i3gaps needed) ────────────────────────────────
gaps inner 6
gaps outer 4
smart_gaps   on
smart_borders on

# ── Floating window rules ─────────────────────────────────────────────────
for_window [app_id="pavucontrol"]                floating enable, resize set 800 500
for_window [app_id="thunar"]                     floating enable
for_window [app_id="nm-connection-editor"]       floating enable
for_window [app_id="org.gnome.Calculator"]       floating enable
for_window [app_id="lazygit"]                    floating enable, resize set 1400 900
for_window [window_role="pop-up"]                floating enable
for_window [window_role="dialog"]                floating enable
for_window [window_type="dialog"]                floating enable

# ── Application workspace assignments ────────────────────────────────────
assign [app_id="firefox"]           $ws2
assign [app_id="chromium"]          $ws2
assign [app_id="codium"]            $ws1
assign [class="Code"]               $ws1
assign [app_id="slack"]             $ws4
assign [app_id="discord"]           $ws4
assign [class="VirtualBox Manager"] $ws6

# ── Input ─────────────────────────────────────────────────────────────────
input type:keyboard {
    xkb_options caps:escape    # Caps Lock → Escape
    repeat_delay  250
    repeat_rate   50
}

input type:touchpad {
    dwt              enabled
    tap              enabled
    natural_scroll   enabled
    middle_emulation enabled
}

# ── Output / wallpaper ────────────────────────────────────────────────────
output * bg ~/.config/sway/wallpaper.jpg fill

# ── Idle management (swayidle) ────────────────────────────────────────────
exec swayidle -w \
    timeout 300  'brightnessctl -s set 20%' \
    resume       'brightnessctl -r' \
    timeout 600  'exec $lock' \
    timeout 900  'swaymsg "output * dpms off"' \
    resume       'swaymsg "output * dpms on"' \
    before-sleep 'exec $lock'

# ── Autostart ────────────────────────────────────────────────────────────
exec mako
exec_always --no-startup-id waybar

# Clipboard history daemon
exec wl-paste --type text  --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Screenshot directory
exec mkdir -p ~/Pictures/screenshots
