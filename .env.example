# ─────────────────────────────────────────────────────────────────────────────
# Configuration reference — WHERE THINGS ARE ACTUALLY CONFIGURED
#
# NOTE: This file is NOT read by setup.sh or any module. There is no .env loading
# in this project. It exists only to point you at the real configuration points
# below — copying it to ".env"/".env.local" does nothing. Edit the files / answer
# the prompts named here instead.
# ─────────────────────────────────────────────────────────────────────────────

# Git identity
#   Prompted by scripts/07-post-installation.sh and written to ~/.gitconfig.local
#   (the tracked config/shell/.gitconfig includes it). Or set manually:
#     git config --file ~/.gitconfig.local user.name  "Your Name"
#     git config --file ~/.gitconfig.local user.email "you@example.com"

# SSH key
#   scripts/07-post-installation.sh generates an ed25519 key (~/.ssh/id_ed25519)
#   if none exists, then prints the public key to add to GitHub.

# Docker
#   Installed from Docker's APT repo by scripts/02-development-tools.sh. For a
#   registry mirror / storage driver, create /etc/docker/daemon.json yourself.

# Kubernetes (kind)
#   kind/kubectl/helm/k9s installed by scripts/02-development-tools.sh.
#   Create clusters with: kind create cluster --name dev

# Power management (TLP) — edit /etc/tlp.d/debian-setup.conf, then: sudo tlp start
#   Defaults: CPU_BOOST_ON_BAT=0, START_CHARGE_THRESH_BAT0=75, STOP_CHARGE_THRESH_BAT0=80
#   (set STOP=100 for maximum runtime per charge). See scripts/04-power-management.sh.

# DNS — configured via a systemd-resolved drop-in by scripts/05-networking.sh:
#   /etc/systemd/resolved.conf.d/dns-debian-setup.conf  (Cloudflare 1.1.1.1 + Quad9 fallback)

# Editor / pager / shell — set in the shell dotfiles (config/shell/.bashrc, .zshrc):
#   EDITOR=nvim, PAGER=less; change the default shell with: chsh -s /bin/zsh

# Neovim / tmux / fzf — Neovim reuses ~/.vimrc via config/nvim/init.vim; fzf
#   keybindings + completion are wired up in the shell dotfiles automatically.
