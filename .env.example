# .env.example — Environment Configuration Template
#
# Usage:
#   cp .env.example .env.local
#   # Edit .env.local with your values
#   source .env.local && sudo -E ./setup.sh
#
# Note: Binary version pinning belongs in versions.env, not here.

# ── Git ──────────────────────────────────────────────────────────────────────
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="your.email@example.com"

# ── SSH ──────────────────────────────────────────────────────────────────────
SSH_KEY_TYPE=ed25519

# ── Docker ───────────────────────────────────────────────────────────────────
DOCKER_REGISTRY_MIRROR=https://mirror.gcr.io
DOCKER_STORAGE_DRIVER=overlay2

# ── Kubernetes ───────────────────────────────────────────────────────────────
KIND_CLUSTER_NAME=dev
KIND_KUBECONFIG=~/.kube/config

# ── Network / DNS ────────────────────────────────────────────────────────────
# Written to systemd-resolved drop-in. Defaults: Cloudflare + Quad9.
DNS_PRIMARY=1.1.1.1
DNS_FALLBACK=9.9.9.9
TIMEZONE=UTC

# ── Power Management (TLP) ───────────────────────────────────────────────────
# Battery thresholds only apply on ThinkPad / System76 / TUXEDO hardware.
TLP_CPU_BOOST_ON_AC=1
TLP_CPU_BOOST_ON_BAT=0
TLP_START_CHARGE_THRESH=20
TLP_STOP_CHARGE_THRESH=80

# ── Editors & Shell ──────────────────────────────────────────────────────────
EDITOR=nvim
PAGER=less
SHELL=/bin/zsh

# ── Optional components ──────────────────────────────────────────────────────
INSTALL_NVIM_CONFIG=1      # LazyVim for Neovim
INSTALL_TMUX_CONFIG=1
INSTALL_FZF_COMPLETION=1
