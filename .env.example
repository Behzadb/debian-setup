.env.example
# Environment Configuration Template
# Copy to .env.local and customize

# Git Configuration
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="your.email@example.com"

# SSH Configuration
SSH_KEY_TYPE=ed25519
SSH_KEY_BITS=4096

# Docker Configuration
DOCKER_REGISTRY_MIRROR=https://mirror.gcr.io
DOCKER_STORAGE_DRIVER=overlay2

# Kubernetes Configuration
K8S_VERSION=latest
KIND_CLUSTER_NAME=dev
KIND_KUBECONFIG=~/.kube/config

# Power Management (TLP)
TLP_CPU_BOOST_ON_AC=1
TLP_CPU_BOOST_ON_BAT=0
TLP_START_CHARGE_THRESH=20
TLP_STOP_CHARGE_THRESH=80

# Network Configuration
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=1.0.0.1
TIMEZONE=UTC

# Development Environment
EDITOR=nvim
PAGER=less
SHELL=/bin/zsh

# Optional: Development Extras
INSTALL_NVIM_CONFIG=1
INSTALL_TMUX_CONFIG=1
INSTALL_FZF_COMPLETION=1
